{
  "backend": "openai_http",
  "backend_kwargs": {
    "target": "http://localhost:8000",
    "request_format": "/v1/chat/completions",
    "stream": true,
    "extras": {
      "body": {
        "temperature": 0.0
      }
    }
  },
  "profile": {
    "type_": "poisson",
    "strategy_type": "poisson",
    "rate": [
      20.0
    ],
    "max_concurrency": 256,
    "rampup_duration": 30.0
  },
  "warmup": 30.0,
  "data": [
    {
      "kind": "synthetic_text",
      "prefix_buckets": [
        {
          "bucket_weight": 70,
          "prefix_count": 8,
          "prefix_tokens": 264
        },
        {
          "bucket_weight": 30,
          "prefix_count": 4,
          "prefix_tokens": 512
        }
      ],
      "prompt_tokens": 264,
      "output_tokens": 1024,
      "turns": 10
    }
  ]
}