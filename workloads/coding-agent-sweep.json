{
  "backend": "openai_http",
  "backend_kwargs": {
    "target": "http://localhost:8000",
    "request_format": "/v1/chat/completions",
    "stream": true,
    "extras": {
      "body": {
        "temperature": 0.0
      }
    }
  },
  "profile": {
    "type_": "sweep",
    "strategy_type": "constant",
    "sweep_size": 4
  },
  "warmup": 30.0,
  "data": [
    {
      "kind": "synthetic_text",
      "prefix_buckets": [
        {
          "bucket_weight": 70,
          "prefix_count": 1,
          "prefix_tokens": 30480
        },
        {
          "bucket_weight": 30,
          "prefix_count": 1,
          "prefix_tokens": 56864
        }
      ],
      "prompt_tokens": 1024,
      "output_tokens": 1024,
      "turns": 10
    }
  ]
}