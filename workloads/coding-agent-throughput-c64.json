{
  "metadata": {
    "labels": {
      "name": "coding-agent-throughput-c64",
      "description": "Coding-agent throughput probe capped at max_concurrency=64."
    }
  },
  "spec": {
    "backend": {
      "kind": "openai_http",
      "target": "http://localhost:8000",
      "request_format": "/v1/chat/completions",
      "stream": true,
      "tool_call_missing_behavior": "ignore_continue",
      "multiturn_reasoning": true,
      "extras": {
        "body": {
          "temperature": 0.0
        }
      }
    },
    "profile": {
      "kind": "throughput",
      "max_concurrency": 64,
      "rampup_duration": 30.0,
      "warmup": 30.0
    },
    "data": [
      {
        "kind": "synthetic_text",
        "prefix_buckets": [
          {
            "bucket_weight": 70,
            "prefix_count": 8,
            "prefix_tokens": 20480
          },
          {
            "bucket_weight": 30,
            "prefix_count": 4,
            "prefix_tokens": 36864
          }
        ],
        "prompt_tokens": 1024,
        "output_tokens": 1024,
        "turns": 20,
        "tool_call_turns": 15
      }
    ],
    "constraints": [
      {
        "kind": "max_duration",
        "seconds": 900
      },
      {
        "kind": "max_global_error_rate",
        "rate": 0.05,
        "minimum": 50
      }
    ]
  }
}
